# 复制为 deploy/.env 后修改。至少替换 POSTGRES_PASSWORD 与 JWT_SECRET。
# 生成 JWT_SECRET：openssl rand -base64 48
# 已有 .env 的环境执行 deploy/scripts/merge_env.sh 补齐新增项，不会覆盖已有值。

# ---- 基础 ----
POSTGRES_DB=theseus
POSTGRES_USER=theseus
# 生成建议：openssl rand -hex 24（避免 @ : / # 等会破坏连接串的字符）
POSTGRES_PASSWORD=replace-with-a-strong-database-password
TZ=Asia/Shanghai
HTTP_PORT=8080
# 后端镜像编译并行度。2 核 2 GB 的服务器保持 1，避免 cargo 链接阶段 OOM。
CARGO_BUILD_JOBS=1

# ---- 构建加速（可选）----
# 中国大陆服务器建议填写，留空则使用官方源。
#   APT_MIRROR=mirrors.aliyun.com
#   CARGO_MIRROR=https://rsproxy.cn/index/
#   NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=
CARGO_MIRROR=
NPM_REGISTRY=

# ---- 后端 ----
# 邮件里的验证/重置链接以此为准，必须是用户可访问的对外地址。
# 备案完成前可先填 http://<域名>:8080，备案并配置 HTTPS 后再改成 https://<域名>。
FRONTEND_BASE_URL=https://oj.example.com
JWT_SECRET=replace-with-openssl-rand-base64-48-output
JWT_EXPIRATION_HOURS=24
RUST_LOG=info
# 每个后端进程的连接池上限（API 与各 Worker 各自建池，默认 10）。
# 所有进程之和不要超过下面对 Postgres 的 max_connections 设置（默认 100）。
DB_MAX_CONNECTIONS=10
# 允许跨域访问的站点，逗号分隔；留空表示只允许同源。
# 前后端同域部署（Nginx 反代 /api）时保持留空即可。
# CORS_ALLOWED_ORIGINS=https://oj.example.com
# 第三方账号（GitHub OAuth，可选）
# 回调地址填 {OAUTH_CALLBACK_BASE}/api/auth/oauth/github/callback
# 未设置时 OAUTH_CALLBACK_BASE 等于 FRONTEND_BASE_URL
# OAUTH_CALLBACK_BASE=https://oj.example.com
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ---- 邮件 ----
# 生产环境必须使用 smtp；log 模式会把验证链接写进日志。
EMAIL_MODE=smtp
# 保留引号：备份/恢复脚本会 source 这个文件，尖括号不加引号会被 shell 当成重定向。
EMAIL_FROM="Theseus <no-reply@example.com>"
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TLS=true
# 邮箱验证链接有效期（小时）与密码重置链接有效期（分钟）
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# 邮件发件队列的轮询间隔（秒）
EMAIL_DISPATCH_INTERVAL_SECS=5

# ---- 判题 ----
# 宿主机需安装 Docker 与 runsc（gVisor），并构建 runner 镜像：
#   sudo bash backend-rust/scripts/build_runtime_images.sh
# 仅在本机验证部署时可设 RUN_SANDBOX_RUNTIME=runc + RUN_SANDBOX_ALLOW_RUNC=true。
RUN_CODE_ENABLED=true
SUBMIT_JUDGE_ENABLED=true
# 前端提交按钮入口，修改后需要重新构建前端镜像
# docker compose build frontend && docker compose up -d frontend
VITE_SUBMIT_JUDGE_ENABLED=true
RUN_SANDBOX_RUNTIME=runsc
RUN_SANDBOX_ALLOW_RUNC=false
# Worker 名称与并行判题数。多实例部署时每个实例使用不同名称。
RUN_WORKER_NAME=worker-1
# 2 核 2 GB 服务器保持 1；CPU 与内存充足时可提高并行判题数。
RUN_WORKER_CONCURRENCY=1
RUN_IMAGE_PYTHON=theseus/runner-python:dev
RUN_IMAGE_NODE=theseus/runner-node:dev
RUN_IMAGE_CPP=theseus/runner-cpp:dev
RUN_IMAGE_JAVA=theseus/runner-java:dev
# 编译预算：C++ 头文件与 JSON 库较重，10s/256MB 不够用
RUN_COMPILE_TIMEOUT_SECS=60
RUN_COMPILE_MEMORY_MB=1024
RUN_QUEUE_TIMEOUT_SECS=90
RUN_STALE_TIMEOUT_SECS=300
RUN_MAX_DELIVERIES=3
RUN_CLAIM_INTERVAL_SECS=30
RUN_REAPER_INTERVAL_SECS=30
# 运行队列名称，一般无需修改
# RUN_STREAM=theseus:judge:runs
# RUN_CONSUMER_GROUP=judge-workers
# RUN_DEAD_STREAM=theseus:judge:runs:dead

# 提交判题：独立队列与配额，复用上面的沙箱镜像与编译预算
SUBMIT_MAX_DELIVERIES=3
SUBMIT_QUEUE_TIMEOUT_SECS=90
SUBMIT_STALE_TIMEOUT_SECS=300
SUBMIT_RUN_TIMEOUT_SECS=60
SUBMIT_MAX_CASES=50
# 提交队列名称，一般无需修改
# SUBMIT_STREAM=theseus:judge:submissions
# SUBMIT_CONSUMER_GROUP=judge-submit-workers
# SUBMIT_DEAD_STREAM=theseus:judge:submissions:dead

# ---- 防作弊 ----
# 判题完成后异步扫描同一作业、同一题目的历史提交
ANTICHEAT_ENABLED=true
ANTICHEAT_WORKER_NAME=anticheat-1
ANTICHEAT_WORKER_CONCURRENCY=1
ANTICHEAT_MAX_DELIVERIES=3
ANTICHEAT_CLAIM_INTERVAL_SECS=30
ANTICHEAT_WINDOW_DAYS=30
ANTICHEAT_MAX_CANDIDATES=200
# 阈值必须满足 RECORD <= REPORT <= HIGH
# 达到 REPORT 生成报告，达到 HIGH 标记高风险，低于 REPORT 只记录比对结果
ANTICHEAT_RECORD_THRESHOLD=0.60
ANTICHEAT_REPORT_THRESHOLD=0.80
ANTICHEAT_HIGH_THRESHOLD=0.92
ANTICHEAT_MIN_TOKENS=40
# 防作弊队列名称，一般无需修改
# ANTICHEAT_STREAM=theseus:anticheat:scan
# ANTICHEAT_CONSUMER_GROUP=anticheat-workers
# ANTICHEAT_DEAD_STREAM=theseus:anticheat:scan:dead

# ---- 语义补全 ----
# 仅 C++ / Python；每个在线会话会启动一个 clangd / pyright 进程。
# 2 核 2 GB 服务器建议保持 2，内存充足时可提高到 4~8。
LSP_ENABLED=true
LSP_MAX_SESSIONS=4
# 自定义语言服务器命令（可选）
# LSP_CPP_COMMAND=clangd
# LSP_CPP_ARGS=--background-index=false --clang-tidy=false
# LSP_PYTHON_COMMAND=pyright-langserver
# LSP_PYTHON_ARGS=--stdio

# ---- AI 助手 ----
# Plus 会员专属；使用 OpenAI 兼容接口。
# AI_ENABLED=true 时必须填写 AI_API_KEY，否则后端启动失败。
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# AI_API_KEY=
# 单次回复与单用户每日对话次数上限
AI_MAX_TOKENS=1200
AI_DAILY_LIMIT=50

# ---- 论坛 ----
FORUM_ENABLED=true
FORUM_POST_COOLDOWN_SECS=60
FORUM_POST_DAILY_LIMIT=20
FORUM_COMMENT_COOLDOWN_SECS=10
FORUM_COMMENT_DAILY_LIMIT=200
FORUM_REPORT_DAILY_LIMIT=20
FORUM_REPORT_HIDE_THRESHOLD=3
FORUM_MAX_PINNED=5

# ---- 面经导入 ----
# update.sh 会把 doc/interview 下的 Markdown 导入面经板块，已存在的标题跳过。
# 默认作者取最早的启用管理员；需要固定作者时填写用户名。
# INTERVIEW_IMPORT_AUTHOR=
# 设为 1 时覆盖同标题面经的正文与标签，会冲掉界面里的编辑，慎用。
INTERVIEW_IMPORT_UPDATE=0
